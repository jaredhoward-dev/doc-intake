{
 "name": "closing_disclosure",
 "description": "The CFPB Closing Disclosure for a home purchase: loan terms, points, prepaids, initial escrow, prorated property taxes, closing costs, cash to close, and the recording, transfer tax and title charges that add to cost basis. Closing Cost Details amounts are the borrower's columns only (left of the Seller-Paid At Closing column); title and transfer tax lines are one row each.",
 "source": "CFPB Closing Disclosure, model form H-25(A) (12 CFR 1026, Appendix H; content in 12 CFR 1026.38), blank form https://files.consumerfinance.gov/f/201403_cfpb_closing-disclosure_cover-H25A.pdf and sample H-25(B) https://files.consumerfinance.gov/f/201403_cfpb_closing-disclosure_cover-H25B.pdf, linked from https://www.consumerfinance.gov/compliance/compliance-resources/mortgage-resources/tila-respa-integrated-disclosures/forms-samples/, read 2026-11-20. Labels: page 1 Closing Information and Loan Terms; page 2 sections A (01 % of Loan Amount (Points)), E (01 Recording Fees, Transfer Tax), F (01 Homeowner's Insurance Premium, 02 Mortgage Insurance Premium, 03 Prepaid Interest, 04 Property Taxes), G (01-03), J; page 3 Calculating Cash to Close and Summaries of Transactions (K 08-09 paid by seller in advance, L 12-14 unpaid by seller). Title services are labeled 'Title -' (12 CFR 1026.37(f)(2) and 1026.38(f)).",
 "never": [
  "loan ID number and MIC number",
  "borrower, seller, lender and settlement agent names",
  "the property address",
  "NMLS, license and other ID numbers",
  "contact details"
 ],
 "default_group": "cd",
 "groups": {
  "cd": {
   "global": true
  }
 },
 "fields": [
  {"group": "cd", "name": "closing_date", "type": "date", "labels": ["closing date"]},
  {"group": "cd", "name": "sale_price", "type": "money", "labels": ["sale price of property", "sale price"],
   "not": ["personal property"]},
  {"group": "cd", "name": "loan_amount", "type": "money", "labels": ["loan amount"], "not": ["points"]},
  {"group": "cd", "name": "loan_term", "type": "duration", "labels": ["loan term"]},
  {"group": "cd", "name": "interest_rate", "type": "percent", "labels": ["interest rate"]},
  {"group": "cd", "name": "origination_charges", "type": "money", "labels": ["origination charges"],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "points_pct", "type": "percent", "labels": ["of loan amount (points)"], "before": true},
  {"group": "cd", "name": "points_amount", "type": "money", "labels": ["of loan amount (points)"],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "recording_fees", "type": "money", "labels": [["recording fees", "last"]],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "transfer_taxes", "type": "money", "labels": ["transfer taxes", "transfer tax"],
   "column_before": ["at closing", 1], "each": true},
  {"group": "cd", "name": "title_charges", "type": "money", "labels": ["title –"],
   "column_before": ["at closing", 1], "each": true},
  {"group": "cd", "name": "prepaid_homeowners_insurance_months", "type": "duration",
   "labels": ["01 homeowner's insurance premium"], "column_before": ["at closing", 1]},
  {"group": "cd", "name": "prepaid_homeowners_insurance", "type": "money",
   "labels": ["01 homeowner's insurance premium"], "column_before": ["at closing", 1]},
  {"group": "cd", "name": "prepaid_mortgage_insurance", "type": "money",
   "labels": ["02 mortgage insurance premium"], "column_before": ["at closing", 1]},
  {"group": "cd", "name": "prepaid_interest_per_day", "type": "money", "labels": ["prepaid interest"],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "prepaid_interest_total", "type": "money", "labels": [["prepaid interest", "last"]],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "prepaid_property_taxes_months", "type": "duration", "labels": ["04 property taxes"],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "prepaid_property_taxes", "type": "money", "labels": ["04 property taxes"],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "escrow_homeowners_insurance_monthly", "type": "money",
   "labels": ["01 homeowner's insurance"], "not": ["premium"], "column_before": ["at closing", 1]},
  {"group": "cd", "name": "escrow_homeowners_insurance", "type": "money",
   "labels": [["01 homeowner's insurance", "last"]], "not": ["premium"], "column_before": ["at closing", 1]},
  {"group": "cd", "name": "escrow_mortgage_insurance_monthly", "type": "money",
   "labels": ["02 mortgage insurance"], "not": ["premium"], "column_before": ["at closing", 1]},
  {"group": "cd", "name": "escrow_mortgage_insurance", "type": "money",
   "labels": [["02 mortgage insurance", "last"]], "not": ["premium"], "column_before": ["at closing", 1]},
  {"group": "cd", "name": "escrow_property_taxes_monthly", "type": "money", "labels": ["03 property taxes"],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "escrow_property_taxes", "type": "money", "labels": [["03 property taxes", "last"]],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "total_closing_costs", "type": "money",
   "labels": ["total closing costs (borrower-paid)", ["total closing costs (j)", "last"]],
   "column_before": ["at closing", 1]},
  {"group": "cd", "name": "cash_to_close", "type": "money", "labels": ["cash to close"]},
  {"group": "cd", "name": "seller_credit_city_town_taxes", "type": "money", "labels": ["12 city/town taxes"]},
  {"group": "cd", "name": "seller_credit_county_taxes", "type": "money", "labels": ["13 county taxes"]},
  {"group": "cd", "name": "seller_credit_assessments", "type": "money", "labels": ["14 assessments"]},
  {"group": "cd", "name": "paid_by_seller_in_advance_city_town_taxes", "type": "money",
   "labels": ["08 city/town taxes"]},
