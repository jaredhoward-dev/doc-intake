     1
    ],
    "service to",
    "period to",
    "to date",
    "through"
   ],
   "range": 1
  },
  {
   "group": "bill",
   "name": "due_date",
   "type": "date",
   "labels": [
    "due date",
    "date due",
    "payment due",
    "pay by",
    "due by"
   ],
   "required": true
  },
  {
   "group": "bill",
   "name": "amount_due",
   "type": "money",
   "labels": [
    "total amount due",
